{
  "name": "storyforge-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
  "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
  "client:dev": "vite --host 0.0.0.0",
  "server:dev": "node --watch server.js",
  "build": "vite build",
  "desktop": "electron electron.cjs",
  "start": "NODE_ENV=production node server.js"
},
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.2.1",
    "vite": "^6.0.5"
  }
}
